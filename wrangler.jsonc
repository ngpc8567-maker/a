{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "a",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "69a8d672-a0fc-4c6c-a145-a3b928391b94","database_name": "a" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c4e57fd4219f4aa982eef4756deece91" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
